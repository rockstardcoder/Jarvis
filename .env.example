# Copy this file to .env and fill real values locally.
# DO NOT commit .env.

# Firebase Web API key from Firebase Console -> Project Settings -> Web App config
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Admin SDK service account path for migration/admin scripts only.
# DO NOT ship this inside the desktop app.
FIREBASE_SERVICE_ACCOUNT_PATH=data/secrets/firebase-service-account.json
