        return response


    return response
    def _runtime_command(self, text: str, meta: str) -> dict[str, Any]:
        result = self.runtime.send_command(text=text)

        return {
            "ok": result["ok"],
            "message": result["reply"],
            "data": {
                "reply": result["reply"],
                "meta": result.get("meta", meta),
                "raw_output": result.get("raw_output", ""),
                "error": result.get("error", ""),
            },
        }

    def _handle_settings_update(self, payload: dict[str, Any]) -> dict[str, Any]:
        section = str(payload.get("section", "")).strip()
        key = str(payload.get("key", "")).strip()
        value = payload.get("value")

        if not section or not key:
            return self._fail("Missing settings section/key.")

        if section not in self.ui_settings:
            self.ui_settings[section] = {}

        self.ui_settings[section][key] = value
        self._save_ui_settings()

        return self._ok(
            "Setting saved.",
            {
                "reply": f"Saved {section}.{key}.",
                "meta": "SETTINGS / UPDATE",
                "settings": self.ui_settings,
            },
        )

    def _open_folder(self, folder_key: str) -> dict[str, Any]:
        folder_path = self.ui_settings.get("folders", {}).get(folder_key)

        if not folder_path:
            return self._fail(f"Unknown folder: {folder_key}")

        return self._open_path(
            Path(folder_path),
            f"Opened folder: {folder_key}",
            "FOLDER / OPEN",
        )

    def _choose_folder(self, folder_key: str) -> dict[str, Any]:
        if not folder_key:
            return self._fail("Missing folder key.")

        selected_path = ""

        try:
            if webview.windows:
                result = webview.windows[0].create_file_dialog(webview.FOLDER_DIALOG)
                if result:
                    selected_path = str(result[0])
        except Exception:
            selected_path = ""

        if not selected_path:
            return self._fail("No folder selected.")

        self.ui_settings.setdefault("folders", {})[folder_key] = selected_path
        self._save_ui_settings()

        return self._ok(
            "Folder changed.",
            {
                "reply": f"{folder_key} folder changed to: {selected_path}",
                "meta": "FOLDER / CHANGE",
                "folder": folder_key,
                "path": selected_path,
                "settings": self.ui_settings,
            },
        )

    def _open_path(self, path: Path, reply: str, meta: str) -> dict[str, Any]:
        path.mkdir(parents=True, exist_ok=True)
        os.startfile(str(path))

        return self._ok(
            reply,
            {
                "reply": reply,
                "meta": meta,
                "path": str(path),
            },
        )

    def _get_profile_data(self) -> dict[str, Any]:
        auth_result = self.auth.get_current_user()

        if not auth_result.get("ok"):
            return {
                "authenticated": False,
                "name": "",
                "email": "",
                "email_verified": False,
                "accountType": "Email account required",
                "plan": "Not signed in",
                "gpu": "NVIDIA GeForce RTX 4060",
                "cpu": "i5-14600K",
                "ram": "32GB DDR5",
            }

        user = auth_result["data"]["user"]
        system_profile_file = MEMORY_DIR / "system_profile.json"

        profile = {
            "authenticated": True,
            "name": user.get("name", ""),
            "email": user.get("email", ""),
            "email_verified": user.get("email_verified", False),
            "accountType": "Email Account",
            "plan": "Free",
            "gpu": "NVIDIA GeForce RTX 4060",
            "cpu": "i5-14600K",
            "ram": "32GB DDR5",
        }

        if system_profile_file.exists():
            try:
                data = json.loads(system_profile_file.read_text(encoding="utf-8"))

                profile["gpu"] = data.get("gpu") or data.get("GPU") or profile["gpu"]
                profile["cpu"] = data.get("cpu") or data.get("CPU") or profile["cpu"]
                profile["ram"] = data.get("ram") or data.get("RAM") or profile["ram"]
            except Exception:
                pass

        return profile

    def _load_ui_settings(self) -> dict[str, Any]:
        if not UI_SETTINGS_FILE.exists():
            self._write_json(UI_SETTINGS_FILE, DEFAULT_UI_SETTINGS)
            return json.loads(json.dumps(DEFAULT_UI_SETTINGS))

        try:
            loaded = json.loads(UI_SETTINGS_FILE.read_text(encoding="utf-8"))
        except Exception:
            loaded = {}

        merged = json.loads(json.dumps(DEFAULT_UI_SETTINGS))

        for section, value in loaded.items():
            if isinstance(value, dict) and isinstance(merged.get(section), dict):
                merged[section].update(value)
            else:
                merged[section] = value

        return merged

    def _save_ui_settings(self) -> None:
        self._write_json(UI_SETTINGS_FILE, self.ui_settings)

    def _write_json(self, path: Path, data: dict[str, Any]) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(data, indent=2),
            encoding="utf-8",
        )

    def _ok(self, message: str, data: dict[str, Any] | None = None) -> dict[str, Any]:
        return {
            "ok": True,
            "message": message,
            "data": data or {},
        }

    def _fail(self, message: str) -> dict[str, Any]:
        return {
            "ok": False,
            "message": message,
            "data": {
                "reply": message,
                "meta": "UI COMMAND / FAILED",
            },
        }