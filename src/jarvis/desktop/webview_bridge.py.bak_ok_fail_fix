    def handle_command(
        self,
        command: str,
        payload: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        payload = payload or {}

        try:
            if command == "app.ping":
                return self._ok("Jarvis backend bridge is online.", self.runtime.get_status())

            if command == "chat.send":
                return self._handle_chat_send(payload)

            if command == "settings.get":
                return self._ok("Settings loaded.", self.ui_settings)

            if command == "settings.update":
                return self._handle_settings_update(payload)

            if command == "voice.listen_raw":
                return self._listen_raw_voice()

            if command == "voice.listen_once":
                return self._listen_once_and_execute()
            
            if command == "sync.status":
                return self._ok(
                "Sync status loaded.",
                {
                "reply": "Sync status loaded.",
                "meta": "SYNC / STATUS",
                "queue": self.sync_queue.get_status(),
                "firebase": self.firebase_sync.get_status(),
                },
            )

            if command == "sync.upload_pending":
                result = self.firebase_sync.upload_pending(self.sync_queue, limit=20)
                return {
                "ok": result["ok"],
                "message": result["message"],
                "data": {
                "reply": result["message"],
                "meta": "SYNC / UPLOAD PENDING",
                **result.get("data", {}),
}   ,
            }

            if command == "voice.set_audio_output":
                enabled = bool(payload.get("enabled", True))
                self.ui_settings["voice"]["audio_output"] = enabled
                self._save_ui_settings()

                return self._runtime_command(
                    "voice on" if enabled else "voice off",
