class WebviewBridge:
    """
    Bridge between React UI and Python Jarvis backend.
    """

    def __init__(self) -> None:
        self.runtime = JarvisRuntime()
        self.diagnostics = DiagnosticsManager()
        self.auth = AuthManager()
        self.ai_providers = AIProviderManager()
        self.chat_store = ChatFileStore(self.auth)
        self.email_sender = EmailSender()
        self.sync_queue = SyncQueue()
        self.firebase_sync = FirebaseSync()

        SETTINGS_DIR.mkdir(parents=True, exist_ok=True)
        self.ui_settings = self._load_ui_settings()

    def _load_ui_settings(self) -> dict:
        try:
            path = self._ui_settings_path()
            if not path.exists():
                return self._default_ui_settings()

            import json
            data = json.loads(path.read_text(encoding="utf-8"))

            if not isinstance(data, dict):
                return self._default_ui_settings()

            defaults = self._default_ui_settings()
            defaults.update(data)
            return defaults

        except Exception:
            return self._default_ui_settings()

    def _save_ui_settings(self, settings: dict) -> None:
        try:
            import json
            path = self._ui_settings_path()
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(
                json.dumps(settings, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except Exception:
            pass

    def _ui_settings_path(self):
        from pathlib import Path
        root_dir = Path(__file__).resolve().parents[3]
        return root_dir / "data" / "settings" / "ui_settings.json"

