    def _listen_raw_voice(self) -> dict[str, Any]:
        """
        Listen once and return only the recognized text.
        This does NOT execute the command.
        Used by React wake-word loop so voice input can appear in chat first.
        """
        recognizer = sr.Recognizer()

        try:
            with sr.Microphone() as source:
                recognizer.adjust_for_ambient_noise(source, duration=0.25)

                audio = recognizer.listen(
                    source,
                    timeout=4,
                    phrase_time_limit=7,
                )

            try:
                heard_text = recognizer.recognize_google(audio).strip()
            except sr.UnknownValueError:
                return self._ok(
                    "No clear speech detected.",
                    {
                        "heard_text": "",
                        "silent": True,
                        "meta": "VOICE / NO SPEECH",
                    },
                )
            except sr.RequestError as exc:
                return self._fail(f"Speech recognition service error: {exc}")

            if not heard_text:
                return self._ok(
                    "No speech detected.",
                    {
                        "heard_text": "",
                        "silent": True,
                        "meta": "VOICE / EMPTY",
                    },
                )

            return self._ok(
                "Voice captured.",
                {
                    "heard_text": heard_text,
                    "silent": False,
                    "meta": "VOICE / RAW",
                },
            )

        except sr.WaitTimeoutError:
            return self._ok(
                "Voice timeout.",
                {
                    "heard_text": "",
                    "silent": True,
                    "meta": "VOICE / TIMEOUT",
                },
            )
        except Exception as exc:
            return {
                "ok": False,
                "message": f"Voice input error: {exc}",
                "data": {
                    "heard_text": "",
                    "silent": True,
                    "meta": "VOICE / ERROR",
                    "error": traceback.format_exc(),
                },
            }

    def _listen_once_and_execute(self) -> dict[str, Any]:
        recognizer = sr.Recognizer()

        try:
            with sr.Microphone() as source:
                recognizer.adjust_for_ambient_noise(source, duration=0.4)

                audio = recognizer.listen(
                    source,
                    timeout=5,
                    phrase_time_limit=7,
                )

            try:
                heard_text = recognizer.recognize_google(audio).strip()
            except sr.UnknownValueError:
                return self._ok(
                    "No clear speech detected.",
                    {
                        "reply": "No clear speech detected.",
                        "meta": "VOICE / NO SPEECH",
                        "heard_text": "",
                    },
                )
            except sr.RequestError as exc:
                return self._fail(f"Speech recognition service error: {exc}")

            if not heard_text:
                return self._ok(
                    "No speech detected.",
                    {
                        "reply": "No speech detected.",
                        "meta": "VOICE / EMPTY",
                        "heard_text": "",
                    },
                )

            result = self.runtime.send_command(text=heard_text)

            return {
                "ok": result["ok"],
                "message": result["reply"],
                "data": {
                    "reply": f"Heard: {heard_text}\n\n{result['reply']}",
                    "meta": "VOICE / COMMAND EXECUTED",
                    "heard_text": heard_text,
                    "raw_output": result.get("raw_output", ""),
                    "error": result.get("error", ""),
                },
            }

        except sr.WaitTimeoutError:
            return self._ok(
                "No speech detected within 5 seconds.",
                {
                    "reply": "No speech detected within 5 seconds.",
                    "meta": "VOICE / TIMEOUT",
                    "heard_text": "",
                },
            )
        except Exception as exc:
            return {
                "ok": False,
                "message": f"Voice input error: {exc}",
                "data": {
                    "reply": f"Voice input error: {exc}",
                    "meta": "VOICE / ERROR",
                    "error": traceback.format_exc(),
                },
            }


    def _handle_chat_send(self, payload):
        from datetime import datetime

        payload = payload or {}
        text = str(payload.get("text", "")).strip()
        model = str(payload.get("model", "llama3.1:8b")).strip()

        if not text:
            return {
                "ok": False,
                "message": "Empty message.",
                "data": {
                    "reply": "Empty message.",
                    "meta": "CHAT / EMPTY",
                },
            }

        result = self.runtime.send_command(text=text, model=model)

        response = {
            "ok": bool(result.get("ok", True)),
            "message": result.get("reply", ""),
            "data": {
                "reply": result.get("reply", ""),
                "meta": result.get("meta", "CHAT / RESPONSE"),
                "raw_output": result.get("raw_output", ""),
                "model": result.get("model", model),
                "should_exit": result.get("should_exit", False),
                "error": result.get("error", ""),
            },
        }

        try:
            if not hasattr(self, "sync_queue"):
                from jarvis.app.sync_queue import SyncQueue
                self.sync_queue = SyncQueue()

            if not hasattr(self, "firebase_sync"):
                from jarvis.app.firebase_sync import FirebaseSync
                self.firebase_sync = FirebaseSync()

            user_id = "guest_user"
            user_email = ""
            user_name = "Guest"

            try:
                current_user = self.auth.get_current_user()
                if current_user.get("ok"):
                    user = current_user.get("data", {}).get("user", {})
                    user_id = str(user.get("id") or user.get("email") or "guest_user")
                    user_email = str(user.get("email", ""))
                    user_name = str(user.get("name", "Guest"))
            except Exception:
                pass

            queued = self.sync_queue.enqueue_record(
                kind="chat_event",
                user_id=user_id,
                payload={
                    "title": text[:50] or "Untitled chat event",
                    "user": {
                        "id": user_id,
                        "email": user_email,
                        "name": user_name,
                    },
                    "model": model,
                    "created_at": datetime.now().isoformat(timespec="seconds"),
                    "messages": [
                        {
                            "role": "user",
                            "text": text,
                            "created_at": datetime.now().isoformat(timespec="seconds"),
                        },
                        {
                            "role": "assistant",
                            "text": result.get("reply", ""),
                            "meta": result.get("meta", ""),
                            "created_at": datetime.now().isoformat(timespec="seconds"),
                        },
                    ],
                    "runtime": {
                        "ok": bool(result.get("ok", False)),
                        "raw_output": result.get("raw_output", ""),
                        "error": result.get("error", ""),
                    },
                },
            )

            upload_result = self.firebase_sync.upload_pending(self.sync_queue, limit=5)

            response["data"]["sync"] = {
                "queued": queued,
                "upload_result": upload_result,
            }

        except Exception as exc:
            response["data"]["sync"] = {
                "ok": False,
                "message": f"Sync failed but chat completed: {exc}",
            }

        return response

